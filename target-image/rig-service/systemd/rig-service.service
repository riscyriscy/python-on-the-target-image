[Unit]
Description=Telemetry collector for the test rig
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/python3 -m rig_service
WatchdogSec=10
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=rig
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
